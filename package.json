{
  "name": "webcon",
  "version": "1.0.0",
  "private": true,
  "description": "ヒグマとの共生を伝える静的サイト「となりの、デカくて不器用なヤツ」",
  "type": "commonjs",
  "license": "ISC",
  "author": "",
  "keywords": [],
  "scripts": {
    "build": "sass src/scss:public/css --style=expanded --no-source-map",
    "dev": "sass --watch src/scss:public/css --style=expanded",
    "serve": "python3 -m http.server 8000",
    "lint": "eslint src/js",
    "format": "prettier --write \"**/*.{html,js,mjs,scss,json,md}\"",
    "format:check": "prettier --check \"**/*.{html,js,mjs,scss,json,md}\"",
    "start": "npm run dev"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Seigo2058/webcon.git"
  },
  "bugs": {
    "url": "https://github.com/Seigo2058/webcon/issues"
  },
  "homepage": "https://github.com/Seigo2058/webcon#readme",
  "directories": {
    "doc": "docs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.2.1",
    "globals": "^17.5.0",
    "prettier": "^3.7.4",
    "sass": "^1.94.2"
  }
}
